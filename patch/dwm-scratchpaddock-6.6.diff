+	showscratchgroup(selmon, key);
+	if (!c->isdocked)
+		placescratchmain(c);             /* new main: size & center it */
+	arrange(selmon);
+	arrangescratchdock(selmon, key);
+	focus(c);
+	XRaiseWindow(dpy, c->win);
+}
