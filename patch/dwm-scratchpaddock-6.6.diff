+/* ---- scratchpad dock ------------------------------------------------------
+ * A group (scratchkey) holds one main (isdocked==0) + dock window(s)
+ * (isdocked==1) to its right, centered on the work area. Picom animates moves.
+ */
+
+void
+arrangescratchdock(Monitor *m, char key)
+{
+	Client *c, *mainc = NULL, *dock[64];
+	int n = 0, i, bw, gap, mw, mh, dw, my, totalw, gx, dx, cellh;
+
+	if (!m || !key)
+		return;
+
+	/* gather group members on the current tag */
+	for (c = m->clients; c; c = c->next) {
+		if (c->scratchkey != key || HIDDEN(c) || !(c->tags & m->tagset[m->seltags]))
+			continue;
+		if (c->isdocked) {
+			if (n < (int)LENGTH(dock))
+				dock[n++] = c;
+		} else if (!mainc)
+			mainc = c;
+	}
+
+	bw  = mainc ? mainc->bw : (int)borderpx;
+	gap = scratchdock_gap;
+	dw  = scratchdock_dockw;
+
+	/* never resize the main (picom would scale it and desync the right/bottom
+	   border -> flicker); keep its size & y, slide only on x */
+	if (mainc) {
+		mw = mainc->w;
+		mh = mainc->h;
+		my = mainc->y;
+	} else { /* no main: use configured size, center vertically */
+		mw = scratchdock_mainw;
+		mh = scratchdock_mainh;
+		my = m->wy + (m->wh - (mh + 2 * bw)) / 2;
+	}
+
+	/* horizontal footprint, centered */
+	totalw = mw + 2 * bw;
+	if (n > 0)
+		totalw += gap + dw + 2 * bw;
+	gx = m->wx + (m->ww - totalw) / 2;
+
+	if (mainc) {
+		mainc->ignoresizehints = 1;
+		resize(mainc, gx, my, mw, mh, 0); /* x-only move -> picom slides it */
+		XRaiseWindow(dpy, mainc->win);
+	}
+
+	if (n == 0)
+		return;
+
+	dx = gx + mw + 2 * bw + gap;
+	if (!mainc) /* no main: center the dock column alone */
+		dx = m->wx + (m->ww - (dw + 2 * bw)) / 2;
+
+	/* docks match the main's height; stacked docks split it evenly */
+	cellh = (mh - (n - 1) * gap - n * 2 * bw) / n;
+	if (cellh < 1)
+		cellh = 1;
+
+	for (i = 0; i < n; i++) {
+		int cy = my + i * (cellh + 2 * bw + gap);
+		dock[i]->ignoresizehints = 1;
+		resize(dock[i], dx, cy, dw, cellh, 0);
+		XRaiseWindow(dpy, dock[i]->win);
+	}
+}
+
+int
+isscratchclass(Client *c, const char *cls)
+{
+	XClassHint ch = { NULL, NULL };
+	int match = 0;
+
+	if (c && cls && XGetClassHint(dpy, c->win, &ch)) {
+		if (ch.res_class && !strcmp(ch.res_class, cls))
+			match = 1;
+		if (ch.res_class)
+			XFree(ch.res_class);
+		if (ch.res_name)
+			XFree(ch.res_name);
+	}
+	return match;
+}
+
+/* allowed WM_CLASS for a group (unlisted -> default adopt class) */
+static const char *
+scratchallowclass(char key)
+{
+	unsigned int i;
+	for (i = 0; i < LENGTH(scratchallow); i++)
+		if (scratchallow[i].key == key)
+			return scratchallow[i].allowclass;
+	return scratchdockadoptclass;
+}
+
+/* may c join group `key`? NULL allowclass means any class */
+static int
+clientallowed(Client *c, char key)
+{
+	const char *cls = scratchallowclass(key);
+	return !cls || isscratchclass(c, cls);
+}
+
+/* close a client (tears down a group's dock with its main) */
+void
+killscratchclient(Client *c)
+{
+	if (!c)
+		return;
+	if (!sendevent(c, wmatom[WMDelete])) {
+		XGrabServer(dpy);
+		XSetErrorHandler(xerrordummy);
+		XSetCloseDownMode(dpy, DestroyAll);
+		XKillClient(dpy, c->win);
+		XSync(dpy, False);
+		XSetErrorHandler(xerror);
+		XUngrabServer(dpy);
+	}
+}
+
+/* group lookups */
+static Client *
+scratchmain(Monitor *m, char key)
+{
+	Client *c;
+	for (c = m->clients; c; c = c->next)
+		if (c->scratchkey == key && !c->isdocked)
+			return c;
+	return NULL;
+}
+
+static Client *
+scratchdockc(Monitor *m, char key)
+{
+	Client *c;
+	for (c = m->clients; c; c = c->next)
+		if (c->scratchkey == key && c->isdocked)
+			return c;
+	return NULL;
+}
+
+/* exclusive mode: hide (tags=0, not close) every visible group except keepkey */
+static void
+hideotherscratch(Monitor *m, char keepkey)
+{
+	Client *c;
+
+	if (!scratchdock_exclusive)
+		return;
+	for (c = m->clients; c; c = c->next)
+		if (c->scratchkey && c->scratchkey != keepkey
+		    && (c->tags & m->tagset[m->seltags])) {
+			c->tags = 0;
+			setclienttagprop(c);
+		}
+}
+
+/* reveal every member of group `key` on the current tag */
+static void
+showscratchgroup(Monitor *m, char key)
+{
+	Client *c;
+	for (c = m->clients; c; c = c->next)
+		if (c->scratchkey == key) {
+			c->tags = m->tagset[m->seltags];
+			setclienttagprop(c);
+		}
+}
+
+/* spawn a dock kitty for the active group (fallback 's').
+   no main -> do nothing: a dock requires an existing main. focus stays on it. */
+void
+scratchdocknew(const Arg *arg)
+{
+	char key = (activescratchkey && scratchmain(selmon, activescratchkey))
+	           ? activescratchkey : SCRATCHDOCKKEY;
+	Client *mc = scratchmain(selmon, key);
+
+	if (!mc)
+		return;                          /* no main: dock not allowed */
+	if (scratchdock_single && scratchdockc(selmon, key))
+		return;                          /* group already full */
+
+	hideotherscratch(selmon, key);
+	showscratchgroup(selmon, key);
+	focus(mc);
+	arrange(selmon);
+	arrangescratchdock(selmon, key);
+	pendingdockkey = key;
+	spawn(&(Arg){ .v = scratchdocknewcmd });
+}
+
+/* adopt the selected window into the active group (fallback 's').
+   allowed class only. empty group -> main; else dock. an already-scratch
+   selection just reveals + re-centers its group. */
+void
+scratchdockadopt(const Arg *arg)
+{
+	Client *c = selmon->sel, *mc;
+	char key;
+
+	if (!c)
+		return;
+
+	if (c->scratchkey != 0) {
+		hideotherscratch(c->mon, c->scratchkey);
+		showscratchgroup(c->mon, c->scratchkey);
+		arrange(c->mon);
+		arrangescratchdock(c->mon, c->scratchkey);
+		focus(c);
+		XRaiseWindow(dpy, c->win);
+		return;
+	}
+
+	key = (activescratchkey && scratchmain(selmon, activescratchkey))
+	      ? activescratchkey : SCRATCHDOCKKEY;
+	if (!c->wasscratch && !clientallowed(c, key))
