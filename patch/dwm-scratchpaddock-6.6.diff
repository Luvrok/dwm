+/* cycle focus among scratchpad windows only (any group); arg->i: +1/-1 */
+void
+scratchdockcycle(const Arg *arg)
+{
+	Client *c, *members[64];
+	int n = 0, cur = -1, i, dir;
+
+	for (c = selmon->clients; c; c = c->next) {
+		if (c->scratchkey == 0 || !ISVISIBLE(c) || HIDDEN(c))
+			continue;
+		if (n < (int)LENGTH(members)) {
+			if (c == selmon->sel)
+				cur = n;
+			members[n++] = c;
+		}
+	}
+	if (n == 0)
+		return;
+
+	dir = arg->i < 0 ? -1 : 1;
+	if (cur < 0)
+		i = dir > 0 ? 0 : n - 1; /* nothing focused yet: jump in */
+	else
+		i = MOD(cur + dir, n);
+
+	focus(members[i]);
+	restack(selmon);
+	XRaiseWindow(dpy, members[i]->win);
+}
